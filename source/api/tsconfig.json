{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",
    "ignoreDeprecations": "6.0", // added cause baseurl is deprecated
    "baseUrl": "./src/",
    "paths": {
      "@/*": ["./*"]
    }
  }
}
